{
  "expo": {
    "name": "Tacoplan",
    "slug": "tacoplan",
    "version": "2.2.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tacoplan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4C75"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tacoplan",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para autocompletar el lugar de fin de jornada (provincia y país).",
        "NSBluetoothAlwaysUsageDescription": "Tacoplan necesita acceso a Bluetooth para conectarse a tu tacógrafo Smart 2 y registrar automáticamente conducciones, pausas y países.",
        "NSBluetoothPeripheralUsageDescription": "Tacoplan necesita acceso a Bluetooth para conectarse a tu tacógrafo Smart 2."
      }
    },
    "android": {
      "package": "com.yousfbouncy.tacoplanv2",
      "versionCode": 20208,
      "googleServicesFile": "./app/google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F4C75",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-notifications"
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/e8c809db-2b37-4d49-88aa-1e8b49a3ef6d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
