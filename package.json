    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "drizzle-kit": "^0.18.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.0",
    "supabase": "^2.109.1",
    "typescript": "~5.9.2"
  },
  "private": true
